# Server-only secrets (Vercel project environment variables). Never prefix these with VITE_.
ANTHROPIC_API_KEY=your_api_key_here
# Optional. Pinned production model for /api/chat. Defaults to claude-sonnet-4-6.
ANTHROPIC_MODEL=claude-sonnet-4-6
# Redis for Team Rooms, local plan chunks, and chat rate limiting (redis:// or rediss://).
REDIS_URL=

# Browser-visible configuration.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
VITE_CARTO_BASEMAP_KEY=
